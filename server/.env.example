# Copy to .env for running the server outside Docker (docker compose sets these itself).
# Never commit .env. Real secrets in production come from the server's environment.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# PostgreSQL. With docker compose running, the database is on port 55432.
DATABASE_URL=postgresql://souschef:souschef@localhost:55432/souschef
# Tests empty their tables, so they must use a separate database. The name has to contain "test".
DATABASE_URL_TEST=postgresql://souschef:souschef@localhost:55432/souschef_test
DB_POOL_MAX=10

# Signs access tokens. At least 32 random characters:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
PASSWORD_RESET_TTL_MINUTES=30

# Sign in with Google / Apple: the client ids the server accepts ID tokens for (comma separated).
# Leave empty and that provider answers "not available".
GOOGLE_CLIENT_IDS=
# For Apple this is the app's bundle id.
APPLE_CLIENT_IDS=com.lyon98.souschef

# Where the password reset email sends people; the token is added as ?token=...
APP_RESET_URL=souschef://reset-password
CURRENT_TERMS_VERSION=2026-11-01

# true only behind Cloudflare, and only when the server accepts traffic from Cloudflare alone.
TRUST_PROXY=false
RATE_LIMIT_MAX=120
# Sign-in, sign-up, refresh and password reset: attempts per minute per address.
AUTH_RATE_LIMIT_MAX=10

# RevenueCat webhook: set the dashboard's Authorization header value to "Bearer <this>". At least 16 random characters. Empty = webhook off.
REVENUECAT_WEBHOOK_SECRET=

# File uploads (Cloudflare R2 or any S3-compatible bucket). Set all of these or none; unset = uploads answer "not set up".
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Public address of the bucket (no trailing slash), e.g. https://media.souschef.app
STORAGE_PUBLIC_URL=

# AI services. A service with an empty key is off. Model names and prices change often: check them with each provider.
# The funded Gemini key (billing on). Used for private requests, video, and as the overflow when free keys rest.
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.5-flash
# Optional pool of keys WITHOUT billing, separated by commas (max 20). Ordinary requests rotate across them at no cost;
# a rate-limited key rests and the next is used. Free-tier content may be used by Google to improve its products, so
# private requests (health numbers, private chats, receipts) never go to these. Check Google's terms before pooling.
AI_GEMINI_FREE_KEYS=
# When every free key is resting, may the funded key take an ordinary request? (the monthly budget still caps spend)
AI_GEMINI_SPILL_TO_PAID=true
# Extra tasks that always use the funded key (names from server/src/ai/types.ts), separated by commas. Video already does.
AI_GEMINI_PAID_ONLY_TASKS=
# Providers allowed to see private requests, separated by commas. Leave as gemini unless you accept the privacy trade-off.
AI_PRIVATE_PROVIDERS=gemini
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_MODEL=deepseek-chat
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_NEBIUS_API_KEY=
# No default: pick the model (for example a safety model) in the Nebius console. Empty keeps Nebius off.
# Nebius Token Factory (OpenAI-compatible; catalogue: https://tokenfactory.nebius.com/models/catalog)
AI_NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
AI_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Photo jobs (scans, plate checks, captions, cookbook pages, post photos). Chosen by trying the catalogue on real photos.
AI_NEBIUS_VISION_MODEL=MiniMaxAI/MiniMax-M3.1-Flash
AI_NEBIUS_VISION_MODEL_2=deepseek-ai/DeepSeek-V4.1-Flash-1017
# Order photo jobs try providers in. Put gemini first once its account is funded.
AI_VISION_FIRST=nebius-vision,nebius-vision-2,gemini
# Optional dedicated endpoint (your own GPUs): the model is its routing_key; the address is its region's
# (eu-north1 https://api.tokenfactory.nebius.com/v1, eu-west1 https://api.tokenfactory.eu-west1.nebius.com/v1,
# us-central1 https://api.tokenfactory.us-central1.nebius.com/v1); the key is AI_NEBIUS_API_KEY. Tried first for text work.
AI_NEBIUS_DEDICATED_MODEL=
AI_NEBIUS_DEDICATED_BASE_URL=
AI_NEBIUS_DEDICATED_IMAGES=false
# All AI calls together stop once this much has been spent in a calendar month (US dollars, estimated from token counts).
AI_MONTHLY_BUDGET_USD=5
# Price per million tokens, used only for the spending estimate.
AI_PRICE_GEMINI_IN=0.3
AI_PRICE_GEMINI_OUT=2.5
AI_PRICE_DEEPSEEK_IN=0.28
AI_PRICE_DEEPSEEK_OUT=0.42
AI_PRICE_NEBIUS_IN=0.1
AI_PRICE_NEBIUS_OUT=0.3
AI_PRICE_NEBIUS_VISION_IN=0.15
AI_PRICE_NEBIUS_VISION_OUT=0.6
AI_PRICE_NEBIUS_VISION_2_IN=0.3
AI_PRICE_NEBIUS_VISION_2_OUT=1.2

# Recipe imports from a link: how many one address may start per minute (each can open a web page and call the AI).
IMPORT_RATE_LIMIT_MAX=20

# Health tracking is off until this is set: 32 random bytes as base64 (openssl rand -base64 32).
# Losing it makes saved readings unreadable. Keep a copy somewhere safe, apart from the database backups.
HEALTH_DATA_KEY=

# Key rotation: give the new key a new id, move the old one into OLD_KEYS as "1:base64key", restart, then run
#   npm run health:reseal   until it prints remaining 0, and only then remove the old key.
HEALTH_DATA_KEY_ID=1
HEALTH_DATA_OLD_KEYS=

# Words that cannot be posted (whole words, any capitals), separated by commas.
BANNED_TERMS=

# Background jobs (clearing out expired data, finishing games, checking new posts). Several servers are safe: a lock stops double runs.
JOBS_ENABLED=true

# Link imports: the program that reads a video's caption and subtitles (the Docker image sets it). Empty = captions from the
# platforms' public pages only. IMPORT_PROXY_URL routes yt-dlp through a proxy when a platform blocks data-centre addresses.
YT_DLP_PATH=
IMPORT_PROXY_URL=

# Which For You ranking runs: v2 learns each person's taste (what they like, save, cook, hide); v1 is plain engagement (for comparing or rolling back).
FEED_RANKER=v2
