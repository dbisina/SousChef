# Copy to .env for running the server outside Docker (docker compose sets these itself).
# Never commit .env. Real secrets in production come from the server's environment.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# PostgreSQL. With docker compose running, the database is on port 55432.
DATABASE_URL=postgresql://souschef:souschef@localhost:55432/souschef
# Tests empty their tables, so they must use a separate database. The name has to contain "test".
DATABASE_URL_TEST=postgresql://souschef:souschef@localhost:55432/souschef_test
DB_POOL_MAX=10

# Signs access tokens. At least 32 random characters:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
PASSWORD_RESET_TTL_MINUTES=30

# Sign in with Google / Apple: the client ids the server accepts ID tokens for (comma separated).
# Leave empty and that provider answers "not available".
GOOGLE_CLIENT_IDS=
# For Apple this is the app's bundle id.
APPLE_CLIENT_IDS=com.lyon98.souschef

# Where the password reset email sends people; the token is added as ?token=...
APP_RESET_URL=souschef://reset-password
CURRENT_TERMS_VERSION=2026-11-01

# true only behind Cloudflare, and only when the server accepts traffic from Cloudflare alone.
TRUST_PROXY=false
RATE_LIMIT_MAX=120
# Sign-in, sign-up, refresh and password reset: attempts per minute per address.
AUTH_RATE_LIMIT_MAX=10

# RevenueCat webhook: set the dashboard's Authorization header value to "Bearer <this>". At least 16 random characters. Empty = webhook off.
REVENUECAT_WEBHOOK_SECRET=

# File uploads (Cloudflare R2 or any S3-compatible bucket). Set all of these or none; unset = uploads answer "not set up".
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Public address of the bucket (no trailing slash), e.g. https://media.souschef.app
STORAGE_PUBLIC_URL=

# AI services. A service with an empty key is off. Model names and prices change often: check them with each provider.
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.5-flash
AI_DEEPSEEK_API_KEY=
AI_DEEPSEEK_MODEL=deepseek-chat
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_NEBIUS_API_KEY=
# No default: pick the model (for example a safety model) in the Nebius console. Empty keeps Nebius off.
AI_NEBIUS_MODEL=
AI_NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
# All AI calls together stop once this much has been spent in a calendar month (US dollars, estimated from token counts).
AI_MONTHLY_BUDGET_USD=5
# Price per million tokens, used only for the spending estimate.
AI_PRICE_GEMINI_IN=0.3
AI_PRICE_GEMINI_OUT=2.5
AI_PRICE_DEEPSEEK_IN=0.28
AI_PRICE_DEEPSEEK_OUT=0.42
AI_PRICE_NEBIUS_IN=0.2
AI_PRICE_NEBIUS_OUT=0.6
