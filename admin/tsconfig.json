{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@shared": ["../shared/index.ts"], "@shared/*": ["../shared/*"] }
  },
  "include": ["src", "vite.config.ts", "../shared/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
