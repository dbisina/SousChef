# The API's settings in production (copy to .env.production on the server; never commit the real one).
# DATABASE_URL, NODE_ENV, TRUST_PROXY, HOST and PORT are set by docker-compose.prod.yml. The rest of the list, with
# explanations, is in server/.env.example.

LOG_LEVEL=info

# 48 random bytes: openssl rand -base64 48
JWT_SECRET=

# Files (Cloudflare R2). Create a bucket for media, give a token that can read and write only that bucket.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# Sign-in with Google and Apple: the client ids the app uses, separated by commas.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Subscriptions (RevenueCat webhook secret, 16 or more characters).
REVENUECAT_WEBHOOK_SECRET=

# AI. A service without a key is off. The monthly budget is a hard stop.
AI_GEMINI_API_KEY=
AI_DEEPSEEK_API_KEY=
AI_NEBIUS_API_KEY=
AI_NEBIUS_MODEL=
AI_MONTHLY_BUDGET_USD=5

# Health tracking is off until this is set: openssl rand -base64 32. Keep a copy apart from the database backups;
# without it saved readings cannot be read.
HEALTH_DATA_KEY=

# Words that cannot be posted (whole words), separated by commas.
BANNED_TERMS=

# Set to false on a second server so only one runs the background jobs (a lock makes it safe either way).
JOBS_ENABLED=true
