# Caddy terminates TLS with the Cloudflare Origin certificate (Cloudflare SSL mode: Full strict) and passes requests,
# including the live-chat WebSocket at /v1/ws, to the API.
{
	# Cloudflare provides the certificate trust, so Caddy must not try to fetch its own.
	auto_https off
}

{$API_DOMAIN}:443 {
	tls /certs/origin.pem /certs/origin.key
	encode zstd gzip

	# The API accepts at most 256 KB of JSON; files go straight to R2. A little room above that.
	request_body {
		max_size 1MB
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
	}

	reverse_proxy api:3000 {
		# Keep idle chat sockets open between Cloudflare's 100 s pings.
		transport http {
			read_timeout 120s
		}
	}
}

# Plain HTTP only redirects (Cloudflare normally does this before it reaches us).
:80 {
	redir https://{$API_DOMAIN}{uri} permanent
}
